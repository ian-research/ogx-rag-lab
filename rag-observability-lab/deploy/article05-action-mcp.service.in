[Unit]
Description=Article 5 simulated back office (read tools plus one controlled write)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
EnvironmentFile=@CONFIG_PATH@
ExecStart=@APP_DIR@/.venv/bin/python -m uvicorn mcp_action_server:app --host 127.0.0.1 --port 8093 --workers 1 --no-access-log
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
