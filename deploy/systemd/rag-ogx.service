[Unit]
Description=RAG OGX server
After=network-online.target rag-postgres.service rag-vllm.service
Requires=rag-postgres.service rag-vllm.service
PartOf=rag-stack.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/rag-lab
EnvironmentFile=/etc/rag-lab/ogx.env
Environment=PATH=/root/rag-lab/.venv-ogx/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=CUDA_VISIBLE_DEVICES=
ExecStartPre=/root/rag-lab/.venv-ogx/bin/python /root/rag-lab/ogx-rag-lab/scripts/wait-ready.py database --timeout 180
ExecStart=/bin/bash /root/rag-lab/ogx-rag-lab/scripts/start-ogx.sh
ExecStartPost=/usr/bin/python3 /root/rag-lab/ogx-rag-lab/scripts/wait-ready.py ogx --timeout 300
TimeoutStartSec=540
TimeoutStopSec=60
Restart=on-failure
RestartSec=15
UMask=0077

[Install]
WantedBy=rag-stack.target
