# Article 6 lab configuration. Paths come from the template, not from this file.
STATE_DIR=@STATE_DIR@
PRIVATE_DIR=@STATE_DIR@/private
DATA_DIR=@STATE_DIR@/data
DB_PATH=@STATE_DIR@/data/action.db
RUN_ROOT=@STATE_DIR@/evidence/runs
OGX_BASE=http://127.0.0.1:8321
OGX_MODEL=local-vllm/rag-llm
DOC_SERVICE=http://127.0.0.1:8089
ACTION_MCP_URL=http://127.0.0.1:8095/mcp
PUBLIC_BASE=http://127.0.0.1:8094
API_PORT=8094
MCP_PORT=8095
DEFAULT_POLICY=eval3-device
DRAFT_TTL_SECONDS=900
CONFIRM_TTL_SECONDS=600
SUBMIT_TIMEOUT=20
MODEL_TIMEOUT=120
TOOL_TIMEOUT=60
OTEL_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SAMPLE_RATIO=1.0
OTEL_ENV=single-host-lab
LOG_LEVEL=INFO
# Test-only one-shot fault marker; the app never creates it.
ACTION_FAULT_FILE=@STATE_DIR@/data/fault-stage
JAEGER_IMAGE=@JAEGER_IMAGE@
